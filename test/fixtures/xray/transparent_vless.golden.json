{
  "api": {
    "services": [
      "HandlerService",
      "RoutingService"
    ],
    "tag": "fastlane-api"
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "udp": true
      },
      "tag": "socks-in"
    },
    {
      "listen": "127.0.0.1",
      "port": 10809,
      "protocol": "http",
      "settings": {},
      "tag": "http-in"
    },
    {
      "listen": "0.0.0.0",
      "port": 12345,
      "protocol": "dokodemo-door",
      "settings": {
        "followRedirect": true,
        "network": "tcp"
      },
      "sniffing": {
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "enabled": true
      },
      "streamSettings": {
        "sockopt": {
          "tproxy": "redirect"
        }
      },
      "tag": "transparent-in"
    },
    {
      "listen": "0.0.0.0",
      "port": 12345,
      "protocol": "dokodemo-door",
      "settings": {
        "followRedirect": true,
        "network": "udp"
      },
      "sniffing": {
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "enabled": true
      },
      "streamSettings": {
        "sockopt": {
          "tproxy": "tproxy"
        }
      },
      "tag": "transparent-udp-in"
    },
    {
      "listen": "127.0.0.1",
      "port": 10085,
      "protocol": "dokodemo-door",
      "settings": {
        "address": "127.0.0.1"
      },
      "tag": "fastlane-api-in"
    },
    {
      "listen": "127.0.0.1",
      "port": 10810,
      "protocol": "http",
      "settings": {},
      "tag": "fastlane-probe-in-0"
    },
    {
      "listen": "127.0.0.1",
      "port": 10811,
      "protocol": "http",
      "settings": {},
      "tag": "fastlane-probe-in-1"
    }
  ],
  "log": {
    "loglevel": "warning"
  },
  "observatory": {
    "probeInterval": "24h",
    "probeURL": "https://www.gstatic.com/generate_204",
    "subjectSelector": [
      "fastlane-observe-none-"
    ]
  },
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "node1.example.com",
            "port": 443,
            "users": [
              {
                "encryption": "none",
                "flow": "",
                "id": "11111111-1111-1111-1111-111111111111"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "realitySettings": {
          "fingerprint": "chrome",
          "publicKey": "public-key-1",
          "serverName": "edge.example.com",
          "shortId": "ab12cd34"
        },
        "security": "reality",
        "wsSettings": {
          "headers": {
            "Host": "cdn.example.com"
          },
          "path": "/proxy"
        }
      },
      "tag": "fastlane-node-06262d1aeb864e8c"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    },
    {
      "protocol": "freedom",
      "tag": "fastlane-direct"
    }
  ],
  "routing": {
    "balancers": [
      {
        "fallbackTag": "fastlane-direct",
        "selector": [
          "fastlane-node-"
        ],
        "tag": "fastlane-main"
      },
      {
        "fallbackTag": "block",
        "selector": [
          "fastlane-node-"
        ],
        "tag": "fastlane-probe-0"
      },
      {
        "fallbackTag": "block",
        "selector": [
          "fastlane-node-"
        ],
        "tag": "fastlane-probe-1"
      }
    ],
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "balancerTag": "fastlane-main",
        "inboundTag": [
          "transparent-in"
        ],
        "network": "tcp",
        "type": "field"
      },
      {
        "balancerTag": "fastlane-main",
        "inboundTag": [
          "transparent-udp-in"
        ],
        "network": "udp",
        "type": "field"
      },
      {
        "balancerTag": "fastlane-main",
        "inboundTag": [
          "socks-in",
          "http-in"
        ],
        "network": "tcp,udp",
        "type": "field"
      },
      {
        "inboundTag": [
          "fastlane-api-in"
        ],
        "outboundTag": "fastlane-api",
        "type": "field"
      },
      {
        "balancerTag": "fastlane-probe-0",
        "inboundTag": [
          "fastlane-probe-in-0"
        ],
        "network": "tcp,udp",
        "type": "field"
      },
      {
        "balancerTag": "fastlane-probe-1",
        "inboundTag": [
          "fastlane-probe-in-1"
        ],
        "network": "tcp,udp",
        "type": "field"
      }
    ]
  }
}