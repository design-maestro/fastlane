#!/bin/sh /etc/rc.common
set -e

START=89
STOP=11
EXTRA_COMMANDS="status running"

BIN="${FASTLANE_XRAY_BINARY:-/usr/bin/xray}"
CONFIG="${FASTLANE_XRAY_CONFIG:-/etc/xray/config.json}"
PIDFILE="/var/run/xray.pid"
LOGFILE="/var/log/xray.log"

start() {
	stop >/dev/null 2>&1 || true
	[ -x "${BIN}" ] || return 1
	[ -f "${CONFIG}" ] || return 1
	mkdir -p "$(dirname "${PIDFILE}")" "$(dirname "${LOGFILE}")"
	"${BIN}" run -config "${CONFIG}" >>"${LOGFILE}" 2>&1 &
	echo $! > "${PIDFILE}"
	sleep 1
	kill -0 "$(cat "${PIDFILE}")" >/dev/null 2>&1
}

stop() {
	if [ -f "${PIDFILE}" ]; then
		kill "$(cat "${PIDFILE}")" >/dev/null 2>&1 || true
		rm -f "${PIDFILE}"
	fi
}

reload() {
	stop
	start
}

running() {
	if [ -f "${PIDFILE}" ] && kill -0 "$(cat "${PIDFILE}")" >/dev/null 2>&1; then
		return 0
	fi
	return 1
}

status() {
	if running; then
		echo running
		return 0
	fi
	echo inactive
}
