#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

SERVICE_NAME="fastlane"
FASTLANE_BIN="/usr/bin/fastlane"
FASTLANE_CRON_HELPER="/usr/libexec/fastlane-cron"
FASTLANE_AWG_RUNTIME_SOURCE="/usr/libexec/fastlane-amneziawg-go"
FASTLANE_AWG_RUNTIME_TARGET="/usr/bin/amneziawg-go"
FASTLANE_AWG_PROTO_SOURCE="/usr/libexec/fastlane-amneziawg-proto"
FASTLANE_AWG_PROTO_TARGET="/lib/netifd/proto/amneziawg.sh"
FASTLANE_RUNTIME_ROOT="/tmp/fastlane-runtime"

install_awg_runtime() {
	local staged

	[ -x "${FASTLANE_AWG_RUNTIME_SOURCE}" ] || return 0
	if [ -x "${FASTLANE_AWG_RUNTIME_TARGET}" ] && cmp -s "${FASTLANE_AWG_RUNTIME_SOURCE}" "${FASTLANE_AWG_RUNTIME_TARGET}"; then
		return 0
	fi
	staged="${FASTLANE_AWG_RUNTIME_TARGET}.fastlane-new.$$"
	cp "${FASTLANE_AWG_RUNTIME_SOURCE}" "${staged}" || return 1
	chmod 0755 "${staged}" || return 1
	mv -f "${staged}" "${FASTLANE_AWG_RUNTIME_TARGET}"
}

install_awg_protocol() {
	local staged

	[ -f "${FASTLANE_AWG_PROTO_SOURCE}" ] || return 0
	if [ -f "${FASTLANE_AWG_PROTO_TARGET}" ] && cmp -s "${FASTLANE_AWG_PROTO_SOURCE}" "${FASTLANE_AWG_PROTO_TARGET}"; then
		return 0
	fi
	mkdir -p "$(dirname "${FASTLANE_AWG_PROTO_TARGET}")" || return 1
	staged="${FASTLANE_AWG_PROTO_TARGET}.fastlane-new.$$"
	cp "${FASTLANE_AWG_PROTO_SOURCE}" "${staged}" || return 1
	chmod 0755 "${staged}" || return 1
	mv -f "${staged}" "${FASTLANE_AWG_PROTO_TARGET}"
}

migrate_health_runtime_files() {
	local root file source target

	root="$1"
	if [ -e "${FASTLANE_RUNTIME_ROOT}" ] && [ ! -d "${FASTLANE_RUNTIME_ROOT}" ]; then
		rm -f "${FASTLANE_RUNTIME_ROOT}"
	fi
	mkdir -p "${FASTLANE_RUNTIME_ROOT}"
	chmod 700 "${FASTLANE_RUNTIME_ROOT}"
	for file in health-check.request health-check-progress.json health-check.cancel; do
		source="${root}/${file}"
		target="${FASTLANE_RUNTIME_ROOT}/${file}"
		[ -f "${source}" ] || continue
		if [ ! -e "${target}" ]; then
			mv "${source}" "${target}"
		else
			rm -f "${source}"
		fi
	done
}

start_service() {
	local root tick management_listen management_token_file

	root="${FASTLANE_ROOT:-/etc/fastlane}"
	tick="${FASTLANE_SCHEDULER_TICK:-1m}"
	management_listen="${FASTLANE_MANAGEMENT_LISTEN:-}"
	management_token_file="${FASTLANE_MANAGEMENT_TOKEN_FILE:-/etc/fastlane/management.token}"

	[ -x "${FASTLANE_BIN}" ] || return 1
	install_awg_protocol || return 1
	install_awg_runtime || return 1
	[ -x "${FASTLANE_CRON_HELPER}" ] && "${FASTLANE_CRON_HELPER}" ensure-xray-log-retention >/dev/null 2>&1 || true
	migrate_health_runtime_files "${root}"

	procd_open_instance
	procd_set_param command "${FASTLANE_BIN}" --root "${root}" daemon --tick "${tick}"
	if [ -n "${management_listen}" ]; then
		procd_append_param command --management-listen "${management_listen}"
		if [ -f "${management_token_file}" ]; then
			procd_append_param command --management-token-file "${management_token_file}"
		fi
	fi
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
