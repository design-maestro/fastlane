#!/bin/sh
set -eu

FASTLANE_BINARY="${FASTLANE_BINARY:-/usr/bin/fastlane}"
FASTLANE_WGET="${FASTLANE_WGET:-wget}"
FASTLANE_RELEASES_API="${FASTLANE_RELEASES_API:-https://api.github.com/repos/design-maestro/fastlane/releases/latest}"

trim() {
	printf '%s' "${1:-}" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

json_string_value() {
	key="$1"
	sed -n "s/.*\"${key}\":[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" | head -n1
}

fetch_text() {
	"${FASTLANE_WGET}" -qO- "$1"
}

run_upgrade() {
	FASTLANE_FORCE_UPGRADE=1 "${FASTLANE_BINARY}" --upgrade
}

version_compare() {
	left="$1"
	right="$2"
	awk -v a="${left}" -v b="${right}" 'BEGIN { split(a,x,"."); split(b,y,"."); for(i=1;i<=4;i++){sub(/[^0-9].*/,"",x[i]);sub(/[^0-9].*/,"",y[i]); xv=x[i]+0;yv=y[i]+0;if(xv<yv){print -1;exit}if(xv>yv){print 1;exit}}print 0 }'
}

current_version=''
current_commit=''
latest_version=''

if [ -x "${FASTLANE_BINARY}" ]; then
	version_json="$("${FASTLANE_BINARY}" --json version 2>/dev/null || true)"
	current_version="$(printf '%s\n' "${version_json}" | json_string_value version)"
	current_version="${current_version#v}"
	current_commit="$(printf '%s\n' "${version_json}" | json_string_value commit)"
fi

latest_tag="$(fetch_text "${FASTLANE_RELEASES_API}" | json_string_value tag_name)"
latest_version="${latest_tag#v}"
[ -n "${latest_version}" ] || { printf 'Fast Lane release channel returned no version.\n' >&2; exit 1; }

if [ -n "${current_version}" ] && [ -n "${latest_version}" ] && [ "${current_version}" = "${latest_version}" ]; then
	printf '%s\n' 'FASTLANE_SELF_UPDATE_STATUS=up-to-date'
	if [ -n "${current_commit}" ]; then
		printf 'Fast Lane is already up to date (%s, %s).\n' "${current_version}" "${current_commit}"
	else
		printf 'Fast Lane is already up to date (%s).\n' "${current_version}"
	fi
	exit 0
fi

if [ -n "${current_version}" ] && [ "$(version_compare "${latest_version}" "${current_version}")" -lt 0 ]; then
	printf '%s\n' 'FASTLANE_SELF_UPDATE_STATUS=downgrade-blocked'
	printf 'Refusing to downgrade Fast Lane from %s to %s.\n' "${current_version}" "${latest_version}"
	exit 0
fi

before_version="$(trim "${current_version}")"
before_commit="$(trim "${current_commit}")"

run_upgrade

after_version=''
after_commit=''
if [ -x "${FASTLANE_BINARY}" ]; then
	version_json="$("${FASTLANE_BINARY}" --json version 2>/dev/null || true)"
	after_version="$(printf '%s\n' "${version_json}" | json_string_value version)"
	after_version="${after_version#v}"
	after_commit="$(printf '%s\n' "${version_json}" | json_string_value commit)"
fi

printf '%s\n' 'FASTLANE_SELF_UPDATE_STATUS=updated'

if [ -n "${before_version}" ] && [ -n "${before_commit}" ] && [ -n "${after_version}" ] && [ -n "${after_commit}" ]; then
	printf 'Fast Lane updated from %s (%s) to %s (%s).\n' "${before_version}" "${before_commit}" "${after_version}" "${after_commit}"
	exit 0
fi

if [ -n "${after_version}" ] && [ -n "${after_commit}" ]; then
	printf 'Fast Lane installed successfully (%s, %s).\n' "${after_version}" "${after_commit}"
	exit 0
fi

printf 'Fast Lane installed successfully.\n'
